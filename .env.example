# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / publishable key — only used for sign-in cookies; it cannot read any data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# "service_role" / secret key — SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Parent Mode ------------------------------------------------------------
# Random string (32+ chars) used to sign the Parent Mode cookie.
# Generate one with:  openssl rand -base64 48
PARENT_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Optional ---------------------------------------------------------------
# Comma-separated list of emails allowed to use the app (recommended).
ALLOWED_EMAILS=you@example.com
