# Copy this file to ".env.local" and fill in the two values from
# Supabase → Project Settings → API (or "Connect" → App frameworks).
# Never put the service_role / secret key here: the app doesn't need it.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional, only for the automatic database setup during "npm run build".
# Vercel's Supabase integration fills these in for you.
# POSTGRES_URL_NON_POOLING=postgres://...
# HK_JESSICA_EMAIL=jessica@example.com
# HK_MARIANO_EMAIL=mariano@example.com
